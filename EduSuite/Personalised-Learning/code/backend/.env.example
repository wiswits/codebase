# ─── WISWITS PL Module — Environment ───────────────────────────
NODE_ENV=development
PORT=4010

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wiswits_platform
DB_CONNECTION_LIMIT=10
# Dedicated demo tenant id for the self-contained seed
PL_DEMO_ORG_ID=9001

# External module base URLs (QBank / Curriculum are separate services —
# ⚠️ NEVER require() them directly. Talk over HTTP. See CONTRACT rule 16.)
QBANK_API_BASE=http://localhost:4002/api/qbank
CURRICULUM_API_BASE=http://localhost:4001/api/curriculum

# When true, use in-repo mock adapters instead of live external services
USE_MOCK_EXTERNAL=true
