# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
REQUEST_ID_HEADER=x-request-id

# Database
DATABASE_URL=postgresql://hms_user:hms_password@localhost:5432/hms_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=30000

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT / Auth
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...
JWT_AUDIENCE=hms
JWT_ISSUER=apex-os
JWT_ALGORITHMS=RS256
APEX_JWKS_URL=http://localhost:3000/.well-known/jwks.json

# APEX Integration
APEX_FEE_API_URL=http://localhost:3000/apex/v1/fees
APEX_NOTIFICATION_API_URL=http://localhost:3000/apex/v1/notifications
APEX_STUDENT_API_URL=http://localhost:3000/apex/v1/students

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=hms-complaints
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100

# Security
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true
TRUST_PROXY=true
HELMET_ENABLED=true

# Features
PARENT_APPROVAL_DEFAULT=true
ATTENDANCE_CUTOFF_TIME=22:00
QR_ATTENDANCE_ENABLED=false
AUTO_CLOSE_COMPLAINT_DAYS=7
BED_RESERVATION_TTL_HOURS=24

# Audit
AUDIT_ENABLED=true
AUDIT_LOG_LEVEL=info