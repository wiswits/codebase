# Server
PORT=4000
NODE_ENV=development

# Database (MariaDB via mysql2)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=edusuite
DB_USER=edusuite_app
DB_PASSWORD=changeme
DB_CONNECTION_LIMIT=10

# Auth
JWT_SECRET=changeme-use-a-long-random-value
JWT_EXPIRES_IN=1d

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
