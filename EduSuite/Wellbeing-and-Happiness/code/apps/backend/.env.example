# ─── Server ──────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database (admin — for migrations only) ──────────────────────
# Used by db/migrate.js to create schema, the wb DB user, grants, triggers.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
DB_NAME=wiswits

# ─── Database (wellbeing runtime user — restricted grants) ───────
# This user CANNOT see academic/financial/discipline tables. By design.
# See db/migrations/0002_wb_user_and_grants.sql
WB_DB_USER=wiswits_wb
WB_DB_PASSWORD=change-me-strong-secret

# ─── Secrets ─────────────────────────────────────────────────────
# Master key used to wrap per-student journal keys (KMS stand-in).
# In production this MUST be a real KMS. Never commit a real value.
WB_MASTER_KEY=change-me-32-byte-base64-master-key

# Salt for anonymous bullying-report reporter hashing (daily-rotated).
WB_REPORT_SALT=change-me-report-salt
